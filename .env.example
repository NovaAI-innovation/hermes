# Copy to .env at the repo root and fill in the key you use.
# Read by pipeline/embedder.py at import time (real env vars win).

# Active provider: OpenRouter embeddings (qwen/qwen3-embedding-4b)
OPENROUTER_API_KEY=

# Alternative providers
DEEPINFRA_API_KEY=
EMBED_API_KEY=

# Optional overrides
# EMBED_PROVIDER=openrouter
# EMBED_MODEL=qwen/qwen3-embedding-4b
# EMBED_API_BASE=https://openrouter.ai/api/v1
