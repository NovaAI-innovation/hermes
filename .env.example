# Copy to <plugin data home>/.env and fill in the key you use.
#
#   installed : $HERMES_HOME/plugin-data/hermes-docs-qdrant/.env
#   checkout  : hermes-docs-qdrant/.data/.env
#
# Read by hermes-docs-qdrant/ingest.py and pipeline/embedder.py.
# Real environment variables always win over this file.

# Active provider: OpenRouter embeddings (qwen/qwen3-embedding-4b)
OPENROUTER_API_KEY=

# Alternative providers
DEEPINFRA_API_KEY=
EMBED_API_KEY=

# Optional overrides
# HERMES_DOCS_HOME=C:\path\to\data-home
# HERMES_DOCS_EMBED_MODEL=qwen/qwen3-embedding-4b
# HERMES_DOCS_EMBED_BASE=https://openrouter.ai/api/v1
# EMBED_PROVIDER=openrouter
